;; LUP sponsor plan, episodes 690-693 (2026-10-27)
;;
;; Why this file exists: these sponsors are inserted by ART19 into dynamic ad
;; slots, so they are NOT in the Fireside Ads CSV and `sync-sponsorships`
;; will never attach them (it keys off the CSV and skips `Dynamic N` rows by
;; design). They must be attached with `add-sponsorship`.
;;
; Timecode: dynamic inserts have no fixed position in the Fireside audio. The
;; timecode is not rendered on the site - it only orders the sponsor aside - so
;; we set it to the ART19 slot time when known. That makes the list read in the
;; order a listener meets the sponsors, at the cost of a possible swap until
;; someone confirms which sponsor is in which slot.
;;
;; `:title` is the Fireside sponsor title and an exact-match join key. Never
;; vary the spelling or future CSV syncs will silently skip the row.
;; `:campaign-title` must be the existing campaign when the sponsor already
;; exists (Fireside resolves it by name), otherwise the name to create.
;; `:message` must match the feed blurb, with one exception: the site renders
;; the sponsor title as a heading above the message, so a leading "Name: " in
;; the copy doubles it on screen and should be trimmed.

{:podcast "linuxunplugged"

 :sponsors
 {:incogni    {:title "Incogni"
               :url "https://incogni.com/unplugged"
               :promo "UNPLUGGED"
               :campaign-title "Incogni"
               :sponsor-uuid "736e7e47-66ec-4ca1-b25e-d1873983129e"
               :campaign-id "2143"
               ;; Trimmed the leading "Incogni: " from Chris's copy: the page
               ;; renders the sponsor title as a heading, so the prefix read as
               ;; "Incogni Incogni: ...".
               :message "They can't harm you if they can't find you! Take back control of your personal data today. Go to incogni.com/unplugged and use code unplugged for 60% off an annual plan. It's completely risk-free with a 30-day money-back guarantee."}

  :namecheap  {:title "Namecheap"
               :url "https://namecheap.promo"
               :promo "UNPLUGGED"
               :campaign-title "Namecheap"
               :sponsor-uuid "73895a00-1c01-470d-89ff-d88e8de5d17b"
               :campaign-id "2144"
               :message "Use code UNPLUGGED for an extra 15% off VPS hosting."}

  ;; Already in Fireside: sponsor 2233, campaign 2142 "Hostinger AI Builder".
  ;; Do NOT onboard; attach only.
  :hostinger  {:title "Hostinger"
               :url "https://hostinger.com/unplugged"
               :promo "UNPLUGGED"
               :campaign-title "Hostinger AI Builder"
               :sponsor-uuid "8bfb1e79-a40f-4352-91cb-725df5f56da2"
               :campaign-id "2142"
               :message "10% off - already on the site as hostinger.com-lup (ep 688)."}}

